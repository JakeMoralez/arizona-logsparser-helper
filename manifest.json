{
  "manifest_version": 3,
  "name": "Arizona LogsParser Helper",
  "version": "2.1",
  "description": "Помощник для работы с логами Arizona RP",
  "permissions": [
    "storage",
    "notifications",
    "activeTab",
    "tabs",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://arizonarp.logsparser.info/*",
    "http://ip-api.com/*",
    "https://items.sethp.org/*",
    "http://localhost/*",
    "https://arizona-ai.ru/*",
    "https://arizona-ai.tech/*"
  ],
  "optional_permissions": [
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arizonarp.logsparser.info/*"
      ],
      "js": [
        "content/compatibility.js",
        "content/theme.js",
        "content/runtime.js",
        "content/bootstrap.js"
      ],
      "css": [
        "content/startup.css",
        "content/content.css",
        "content/modal-ui.css",
        "content/page-ui.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://arizonarp.logsparser.info/*"
      ],
      "js": [
        "content/stopCopy.js",
        "content/site-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://arizonarp.logsparser.info/*"
      ],
      "js": [
        "shared/inventory.js",
        "content/inventory.js",
        "content/log-requests.js",
        "content/modal-controls.js",
        "content/page-controls.js",
        "content/ui-refinements.js",
        "content/content.js"
      ],
      "run_at": "document_start",
      "css": [
        "shared/inventory.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "content/modules/*.js",
        "popup/vendor/css/fontawesome.min.css",
        "popup/vendor/webfonts/*"
      ],
      "matches": [
        "https://arizonarp.logsparser.info/*"
      ]
    }
  ]
}
